# ============================================================
#  Copie ce fichier en ".env" puis edite les valeurs.
#  Le .env n'est JAMAIS commit (voir .gitignore).
# ============================================================

# --- Identite / systeme -------------------------------------
TZ=Europe/Paris
PUID=1000
PGID=1000

# --- Build Project Zomboid ----------------------------------
# "unstable" = branche Build 42. Laisse vide pour la branche publique.
PZ_BRANCH=unstable
PZ_BRANCH_PASSWORD=
# false = ne pas re-verifier Steam a chaque demarrage (boot plus rapide,
# et surtout : fige la build installee, ex. 42.20.2)
UPDATE_ON_START=true

# --- Pin d'une build precise (optionnel, voir docs/PINNING.md) ---
# Fige une version exacte, reproductible meme sur une machine neuve.
# Les deux IDs se recuperent ensemble sur https://steamdb.info/app/380870/depots/
# Laisse vide pour suivre la derniere build de la branche.
PZ_MANIFEST_ID=
PZ_DEPOT_ID=
# true = si le pin echoue, le conteneur s'arrete au lieu d'installer la
# derniere build. A garder en prod.
PZ_PIN_STRICT=true

# --- Serveur ------------------------------------------------
SERVER_NAME=servertest
SERVER_PUBLIC=false
SERVER_PUBLIC_NAME=Mon serveur B42
# mot de passe pour rejoindre le serveur (vide = libre)
SERVER_PASSWORD=
# mot de passe du compte "admin" in-game (OBLIGATOIRE)
ADMIN_PASSWORD=change-moi-vraiment
SERVER_MEMORY=6g
MAX_PLAYERS=16
PZ_PORT=16261

# --- RCON (utilise par le panel web) ------------------------
RCON_PASSWORD=change-moi-aussi
# Delai de grace avant que le healthcheck RCON compte les echecs. Doit couvrir
# le telechargement Steam + la generation de la carte au premier demarrage.
PZ_HEALTH_START_PERIOD=900s

# --- Mods ---------------------------------------------------
# Mods=... : IDs internes des mods, separes par des ;
MOD_IDS=
# WorkshopItems=... : IDs Steam Workshop, separes par des ;
WORKSHOP_IDS=

# Ces reglages ne sont appliques qu'au PREMIER demarrage : ensuite c'est le
# panel qui fait foi (il edite le meme .ini). Pour reimposer une ou plusieurs
# cles depuis ce fichier au prochain demarrage, liste-les ici puis vide la
# variable une fois que c'est fait.
# Cles concernees : Public PublicName MaxPlayers Password Mods WorkshopItems
# ex: PZ_FORCE_INI_KEYS=Mods,WorkshopItems
PZ_FORCE_INI_KEYS=

# --- Panel web ----------------------------------------------
PANEL_PORT=3001
# interface d'ecoute du panel sur l'hote.
# Mets 127.0.0.1 des que Caddy est en place (ci-dessous) : le panel n'est
# alors plus accessible que via le reverse proxy.
PANEL_BIND=0.0.0.0
# ex: https://pz.mondomaine.fr  (si reverse proxy)
PANEL_CORS_ORIGINS=
# optionnel, enrichit les metadonnees des mods
STEAM_API_KEY=
LOG_LEVEL=info

# --- Backup planifie ----------------------------------------
# Heure du backup quotidien (HH:MM, dans le TZ ci-dessus).
BACKUP_AT=04:00
# Nombre d'archives conservees dans ./backups (les plus vieilles sont
# supprimees automatiquement).
BACKUP_KEEP=7
# true = faire un backup immediatement au demarrage du conteneur (utile pour
# tester la config sans attendre l'heure dite).
BACKUP_ON_START=false

# --- Reverse proxy Caddy (profil "proxy", optionnel) --------
# Domaine pointant vers l'IP publique de la machine. Renseigne-le pour
# obtenir un certificat Let's Encrypt automatiquement (ports 80 et 443
# doivent etre ouverts). Laisse vide pour du HTTP simple en local.
CADDY_DOMAIN=

