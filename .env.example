# ============================================================
#  Copy this file to ".env" then edit the values.
#  The .env file is NEVER committed (see .gitignore).
#  FR : Copie ce fichier en ".env" puis edite les valeurs.
#  FR : Le .env n'est JAMAIS commit (voir .gitignore).
# ============================================================

# --- Identity / system --------------------------------------
# FR : Identite / systeme
TZ=Europe/Paris
PUID=1000
PGID=1000

# --- Project Zomboid build ----------------------------------
# FR : Build Project Zomboid
# Steam branch. Leave EMPTY: Build 42 is the public branch now.
# Known branches: "" (public, Build 42), "legacy41" (Build 41.78.20),
# "42.19" (Build 42.19.1). A branch that does not exist makes SteamCMD fail
# with "Missing configuration".
# FR : Branche Steam. Laisse VIDE : Build 42 est desormais la branche
# FR : publique. Branches connues : "" (public, Build 42), "legacy41"
# FR : (Build 41.78.20), "42.19". Une branche inexistante fait echouer
# FR : SteamCMD avec "Missing configuration".
PZ_BRANCH=
PZ_BRANCH_PASSWORD=
# false = do not re-check Steam on every start (faster boot, and above all it
# freezes the installed build, e.g. 42.20.2).
# FR : false = ne pas re-verifier Steam a chaque demarrage (boot plus rapide,
# FR : et surtout : fige la build installee, ex. 42.20.2)
UPDATE_ON_START=true

# --- Server -------------------------------------------------
# FR : Serveur
SERVER_NAME=servertest
SERVER_PUBLIC=false
SERVER_PUBLIC_NAME=Mon serveur B42
# password required to join the server (empty = open)
# FR : mot de passe pour rejoindre le serveur (vide = libre)
SERVER_PASSWORD=
# password of the in-game "admin" account (MANDATORY)
# FR : mot de passe du compte "admin" in-game (OBLIGATOIRE)
ADMIN_PASSWORD=change-moi-vraiment
SERVER_MEMORY=6g
MAX_PLAYERS=16
PZ_PORT=16261

# --- RCON (used by the web panel) ---------------------------
# FR : RCON (utilise par le panel web)
RCON_PASSWORD=change-moi-aussi
# Grace period before the RCON healthcheck starts counting failures. It must
# cover the Steam download plus map generation on the very first start.
# FR : Delai de grace avant que le healthcheck RCON compte les echecs. Doit
# FR : couvrir le telechargement Steam + la generation de la carte au premier
# FR : demarrage.
PZ_HEALTH_START_PERIOD=900s

# --- Mods ---------------------------------------------------
# Mods=... : internal mod IDs, separated by ;
# FR : Mods=... : IDs internes des mods, separes par des ;
MOD_IDS=
# WorkshopItems=... : Steam Workshop IDs, separated by ;
# FR : WorkshopItems=... : IDs Steam Workshop, separes par des ;
WORKSHOP_IDS=

# These settings are only applied on the FIRST start: afterwards the panel is
# the source of truth (it edits the same .ini). To force one or more keys from
# this file on the next start, list them here, then clear the variable again
# once it is done.
# Keys concerned: Public PublicName MaxPlayers Password Mods WorkshopItems
# e.g. PZ_FORCE_INI_KEYS=Mods,WorkshopItems
# FR : Ces reglages ne sont appliques qu'au PREMIER demarrage : ensuite c'est
# FR : le panel qui fait foi (il edite le meme .ini). Pour reimposer une ou
# FR : plusieurs cles depuis ce fichier au prochain demarrage, liste-les ici
# FR : puis vide la variable une fois que c'est fait.
# FR : Cles concernees : Public PublicName MaxPlayers Password Mods
# FR : WorkshopItems
PZ_FORCE_INI_KEYS=

# --- Web panel ----------------------------------------------
# FR : Panel web
PANEL_PORT=3001
# Interface the panel listens on, on the host.
# Set 127.0.0.1 as soon as Caddy is in place (below): the panel is then only
# reachable through the reverse proxy.
# FR : interface d'ecoute du panel sur l'hote.
# FR : Mets 127.0.0.1 des que Caddy est en place (ci-dessous) : le panel n'est
# FR : alors plus accessible que via le reverse proxy.
PANEL_BIND=0.0.0.0
# e.g. https://pz.mydomain.com  (when behind a reverse proxy)
# FR : ex: https://pz.mondomaine.fr  (si reverse proxy)
PANEL_CORS_ORIGINS=
# optional, enriches mod metadata
# FR : optionnel, enrichit les metadonnees des mods
STEAM_API_KEY=
LOG_LEVEL=info
# Lets the panel start/stop/restart the game container, which also fixes the
# "Process Down" indicator and the inert Start button. BOTH lines are needed.
#
# Read this before enabling. The Docker socket is an unauthenticated root-level
# API: whoever reaches it can create a container that mounts the host disk, and
# owns the machine. Enabling this turns a panel compromise into a full host
# compromise. Only do it when the panel is NOT reachable from the Internet:
# either an SSH tunnel with PANEL_BIND=127.0.0.1 and no Caddy, or
# PANEL_ALLOWED_IPS narrowed to your own address (see below).
#
# FR : Permet au panel de demarrer/arreter/redemarrer le conteneur de jeu, ce
# FR : qui corrige aussi l'indicateur "Process Down" et le bouton Start inerte.
# FR : Les DEUX lignes sont necessaires.
# FR : A lire avant d'activer. Le socket Docker est une API root sans
# FR : authentification : qui l'atteint peut creer un conteneur montant le
# FR : disque de l'hote, et possede la machine. L'activer transforme une
# FR : compromission du panel en compromission totale de l'hote. Ne le fais que
# FR : si le panel n'est PAS joignable depuis Internet : tunnel SSH avec
# FR : PANEL_BIND=127.0.0.1 et sans Caddy, ou PANEL_ALLOWED_IPS restreint a ton
# FR : adresse (voir plus bas).
#
# PANEL_BIND=127.0.0.1 is REQUIRED here, not merely advised: a port published
# on 0.0.0.0 bypasses Caddy, and therefore bypasses PANEL_ALLOWED_IPS entirely.
# UFW will not save you, because Docker writes its iptables rules upstream of
# it: `ufw deny 3001` has no effect on a published port.
#
# FR : PANEL_BIND=127.0.0.1 est OBLIGATOIRE ici, pas seulement conseille : un
# FR : port publie sur 0.0.0.0 contourne Caddy, donc contourne entierement
# FR : PANEL_ALLOWED_IPS. UFW ne te sauvera pas, Docker ecrivant ses regles
# FR : iptables en amont : `ufw deny 3001` n'a aucun effet sur un port publie.
PANEL_DOCKER_CONTROL=false
# Leave empty to mount nothing. Set to /var/run/docker.sock to enable.
# FR : Laisse vide pour ne rien monter. Mets /var/run/docker.sock pour activer.
PANEL_DOCKER_SOCKET=
# GID of the socket's group on the host, needed because the panel drops to
# PUID:PGID. Without it the socket is visible but unreadable, the card shows
# "Container Down" while RCON reports the server up, and the panel logs
# "connect EACCES /var/run/docker.sock".
#   stat -c '%g' /var/run/docker.sock
# Defaults to PGID, which the panel's entrypoint ignores as a no-op.
# FR : GID du groupe du socket sur l'hote, necessaire car le panel redescend en
# FR : PUID:PGID. Sans lui le socket est visible mais illisible, la carte
# FR : affiche "Container Down" alors que RCON dit le serveur en marche, et le
# FR : panel journalise "connect EACCES /var/run/docker.sock".
# FR : Vaut PGID par defaut, que l'entrypoint du panel ignore sans effet.
PANEL_DOCKER_GID=

# --- Scheduled backup ---------------------------------------
# FR : Backup planifie
# Time of the daily backup (HH:MM, in the TZ set above).
# FR : Heure du backup quotidien (HH:MM, dans le TZ ci-dessus).
BACKUP_AT=04:00
# Number of archives kept in ./backups (the oldest ones are pruned
# automatically).
# FR : Nombre d'archives conservees dans ./backups (les plus vieilles sont
# FR : supprimees automatiquement).
BACKUP_KEEP=7
# true = run a backup immediately when the container starts (handy to test the
# configuration without waiting for the scheduled time).
# FR : true = faire un backup immediatement au demarrage du conteneur (utile
# FR : pour tester la config sans attendre l'heure dite).
BACKUP_ON_START=false

# --- Caddy reverse proxy ("proxy" profile, optional) --------
# FR : Reverse proxy Caddy (profil "proxy", optionnel)
# Domain name pointing at the machine's public IP. Set it to get a Let's
# Encrypt certificate automatically (ports 80 and 443 must be open). Leave
# empty for plain HTTP on a local network.
# FR : Domaine pointant vers l'IP publique de la machine. Renseigne-le pour
# FR : obtenir un certificat Let's Encrypt automatiquement (ports 80 et 443
# FR : doivent etre ouverts). Laisse vide pour du HTTP simple en local.
CADDY_DOMAIN=
# Space-separated CIDRs allowed to reach the panel. Empty or unset lets the
# whole Internet in. Narrow it to your own address to cut the constant
# vulnerability scanning, and as a prerequisite to PANEL_DOCKER_CONTROL.
# Your address: curl -4 ifconfig.me   ->   PANEL_ALLOWED_IPS=203.0.113.7/32
# Only worth it on a stable home IP: losing it locks you out of the panel
# (the SSH tunnel always remains as a way back in).
#
# FR : CIDR autorises a joindre le panel, separes par des espaces. Vide, tout
# FR : Internet entre. Restreins-le a ton adresse pour couper le scan permanent
# FR : de vulnerabilites, et comme prealable a PANEL_DOCKER_CONTROL.
# FR : Ton adresse : curl -4 ifconfig.me
# FR : Utile seulement si ton IP domestique est stable : la perdre te ferme le
# FR : panel (le tunnel SSH reste toujours une porte de secours).
PANEL_ALLOWED_IPS=
