# ============================================================
#  Copy this file to ".env" then edit the values.
#  The .env file is NEVER committed (see .gitignore).
#  FR : Copie ce fichier en ".env" puis edite les valeurs.
#  FR : Le .env n'est JAMAIS commit (voir .gitignore).
# ============================================================

# --- Identity / system --------------------------------------
# FR : Identite / systeme
TZ=Europe/Paris
PUID=1000
PGID=1000

# --- Project Zomboid build ----------------------------------
# FR : Build Project Zomboid
# "unstable" = the Build 42 branch. Leave empty for the public branch.
# FR : "unstable" = branche Build 42. Laisse vide pour la branche publique.
PZ_BRANCH=unstable
PZ_BRANCH_PASSWORD=
# false = do not re-check Steam on every start (faster boot, and above all it
# freezes the installed build, e.g. 42.20.2).
# FR : false = ne pas re-verifier Steam a chaque demarrage (boot plus rapide,
# FR : et surtout : fige la build installee, ex. 42.20.2)
UPDATE_ON_START=true

# --- Pinning an exact build (optional) ----------------------
# FR : Pin d'une build precise (optionnel)
# Pins an exact version, reproducible even on a fresh machine.
# Both IDs are found together on https://steamdb.info/app/380870/depots/
# Leave empty to follow the latest build of the branch.
# FR : Fige une version exacte, reproductible meme sur une machine neuve.
# FR : Les deux IDs se recuperent ensemble sur la meme page SteamDB.
# FR : Laisse vide pour suivre la derniere build de la branche.
PZ_MANIFEST_ID=
PZ_DEPOT_ID=
# true = if pinning fails, the container stops instead of installing the
# latest build. Keep this in production.
# FR : true = si le pin echoue, le conteneur s'arrete au lieu d'installer la
# FR : derniere build. A garder en prod.
PZ_PIN_STRICT=true

# --- Server -------------------------------------------------
# FR : Serveur
SERVER_NAME=servertest
SERVER_PUBLIC=false
SERVER_PUBLIC_NAME=Mon serveur B42
# password required to join the server (empty = open)
# FR : mot de passe pour rejoindre le serveur (vide = libre)
SERVER_PASSWORD=
# password of the in-game "admin" account (MANDATORY)
# FR : mot de passe du compte "admin" in-game (OBLIGATOIRE)
ADMIN_PASSWORD=change-moi-vraiment
SERVER_MEMORY=6g
MAX_PLAYERS=16
PZ_PORT=16261

# --- RCON (used by the web panel) ---------------------------
# FR : RCON (utilise par le panel web)
RCON_PASSWORD=change-moi-aussi
# Grace period before the RCON healthcheck starts counting failures. It must
# cover the Steam download plus map generation on the very first start.
# FR : Delai de grace avant que le healthcheck RCON compte les echecs. Doit
# FR : couvrir le telechargement Steam + la generation de la carte au premier
# FR : demarrage.
PZ_HEALTH_START_PERIOD=900s

# --- Mods ---------------------------------------------------
# Mods=... : internal mod IDs, separated by ;
# FR : Mods=... : IDs internes des mods, separes par des ;
MOD_IDS=
# WorkshopItems=... : Steam Workshop IDs, separated by ;
# FR : WorkshopItems=... : IDs Steam Workshop, separes par des ;
WORKSHOP_IDS=

# These settings are only applied on the FIRST start: afterwards the panel is
# the source of truth (it edits the same .ini). To force one or more keys from
# this file on the next start, list them here, then clear the variable again
# once it is done.
# Keys concerned: Public PublicName MaxPlayers Password Mods WorkshopItems
# e.g. PZ_FORCE_INI_KEYS=Mods,WorkshopItems
# FR : Ces reglages ne sont appliques qu'au PREMIER demarrage : ensuite c'est
# FR : le panel qui fait foi (il edite le meme .ini). Pour reimposer une ou
# FR : plusieurs cles depuis ce fichier au prochain demarrage, liste-les ici
# FR : puis vide la variable une fois que c'est fait.
# FR : Cles concernees : Public PublicName MaxPlayers Password Mods
# FR : WorkshopItems
PZ_FORCE_INI_KEYS=

# --- Web panel ----------------------------------------------
# FR : Panel web
PANEL_PORT=3001
# Interface the panel listens on, on the host.
# Set 127.0.0.1 as soon as Caddy is in place (below): the panel is then only
# reachable through the reverse proxy.
# FR : interface d'ecoute du panel sur l'hote.
# FR : Mets 127.0.0.1 des que Caddy est en place (ci-dessous) : le panel n'est
# FR : alors plus accessible que via le reverse proxy.
PANEL_BIND=0.0.0.0
# e.g. https://pz.mydomain.com  (when behind a reverse proxy)
# FR : ex: https://pz.mondomaine.fr  (si reverse proxy)
PANEL_CORS_ORIGINS=
# optional, enriches mod metadata
# FR : optionnel, enrichit les metadonnees des mods
STEAM_API_KEY=
LOG_LEVEL=info

# --- Scheduled backup ---------------------------------------
# FR : Backup planifie
# Time of the daily backup (HH:MM, in the TZ set above).
# FR : Heure du backup quotidien (HH:MM, dans le TZ ci-dessus).
BACKUP_AT=04:00
# Number of archives kept in ./backups (the oldest ones are pruned
# automatically).
# FR : Nombre d'archives conservees dans ./backups (les plus vieilles sont
# FR : supprimees automatiquement).
BACKUP_KEEP=7
# true = run a backup immediately when the container starts (handy to test the
# configuration without waiting for the scheduled time).
# FR : true = faire un backup immediatement au demarrage du conteneur (utile
# FR : pour tester la config sans attendre l'heure dite).
BACKUP_ON_START=false

# --- Caddy reverse proxy ("proxy" profile, optional) --------
# FR : Reverse proxy Caddy (profil "proxy", optionnel)
# Domain name pointing at the machine's public IP. Set it to get a Let's
# Encrypt certificate automatically (ports 80 and 443 must be open). Leave
# empty for plain HTTP on a local network.
# FR : Domaine pointant vers l'IP publique de la machine. Renseigne-le pour
# FR : obtenir un certificat Let's Encrypt automatiquement (ports 80 et 443
# FR : doivent etre ouverts). Laisse vide pour du HTTP simple en local.
CADDY_DOMAIN=
