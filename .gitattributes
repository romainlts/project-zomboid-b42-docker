# Normalisation des fins de ligne.
# Les scripts et configs sont consommes par des conteneurs Linux :
# du CRLF les casse (bad interpreter: ...^M). On force LF, quelle que soit
# la config git de la machine (core.autocrlf).

* text=auto eol=lf

# --- doivent imperativement rester en LF ---
*.sh            text eol=lf
*.bash          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.ini           text eol=lf
*.template      text eol=lf
*.env           text eol=lf
.env.example    text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
*.md            text eol=lf
*.json          text eol=lf

# --- scripts Windows : eux ont besoin de CRLF ---
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# --- binaires : jamais toucher ---
*.png           binary
*.jpg           binary
*.gz            binary
*.zip           binary
*.tar           binary
